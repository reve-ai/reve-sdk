{
	"name": "@reve-ai/web-sdk",
	"version": "0.1.1",
	"description": "Reve partner API v2 client and layout overlay web component",
	"license": "MIT",
	"author": "Reve AI authors",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"sideEffects": ["./dist/index.js"],
	"files": ["dist"],
	"keywords": ["reve", "image-generation", "layout", "web-component"],
	"repository": {
		"type": "git",
		"url": "https://github.com/reve-ai/reve-sdk"
	},
	"scripts": {
		"_phase:build": "vite build && tsc --pretty && node scripts/verify-standalone.mjs",
		"_phase:clean": "rm -rf dist",
		"_phase:test": "vitest run --coverage",
		"build": "rushx _phase:build",
		"clean": "rushx _phase:clean",
		"pp-lint": "../../s/per-project-lint.sh",
		"prepublishOnly": "npm run clean && npm run build",
		"test": "rushx _phase:test",
		"test:watch": "vitest watch --reporter=basic --coverage"
	},
	"devDependencies": {
		"@reve-tools/vitest-config": "workspace:*",
		"@vitest/coverage-istanbul": "^4.1.8",
		"happy-dom": "^20.8.9",
		"typescript": "^7.0.2",
		"vite": "~8.1.3",
		"vitest": "^4.1.8"
	}
}
