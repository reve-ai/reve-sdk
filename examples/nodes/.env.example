# Reve API key. Get one from https://api.reve.com/console (Settings > API Keys).
# This is read ONLY on the server (Next.js API routes) — it is never sent to
# the browser and must never be prefixed with NEXT_PUBLIC_.
REVE_API_KEY=your_reve_api_key_here

# Optional: override the Reve API base URL (e.g. for a proxy or mock server
# during development). Defaults to https://api.reve.com if unset.
# REVE_API_BASE_URL=https://api.reve.com
